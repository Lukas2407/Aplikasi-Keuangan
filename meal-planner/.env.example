# ------------------------------------------------------------------ database
# Supabase: Settings > Database > Connection string.
#   DATABASE_URL  = koneksi pooler (port 6543, tambahkan ?pgbouncer=true)
#   DIRECT_URL    = koneksi langsung (port 5432), dipakai prisma migrate
# Neon: pakai connection string "pooled" dan "unpooled".
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ------------------------------------------------------------------ auth.js
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=""
# Wajib di produksi, dipakai untuk callback URL OAuth.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Developer > Certificates, Identifiers & Profiles > Services ID.
# AUTH_APPLE_SECRET adalah JWT yang ditandatangani dan kedaluwarsa maksimal
# 6 bulan, jadi jadwalkan pembaruannya.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ------------------------------------------------------------- impor resep AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------ sumber data terbuka
# Wajib menyebut identitas aplikasi: aturan pemakaian Nominatim dan Overpass
# menolak permintaan tanpa User-Agent yang jelas.
SOURCE_USER_AGENT="DapurKita/0.1 (kontak: email-anda@example.com)"

# Kosongkan untuk memakai layanan publik. Isi kalau punya instance sendiri
# (disarankan bila pemakaian sudah rutin, bukan sekadar coba-coba).
OVERPASS_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
OPEN_PRICES_URL="https://prices.openfoodfacts.org/api/v1"

# Berapa lama hasil tarikan dianggap masih segar, dalam jam.
STORE_SYNC_CACHE_HOURS=24
PRICE_SYNC_CACHE_HOURS=12

# Penambal sementara sebelum Auth.js dipasang. Jangan disetel di produksi:
# semua data akan menumpuk di satu pengguna yang sama.
ALLOW_DEV_USER=0

# ------------------------------------------------------------------ gerbang
# Kunci sementara sebelum Auth.js terpasang. WAJIB diisi begitu aplikasinya
# online, kalau tidak semua data jatuh ke satu pengguna yang bisa diakses
# siapa saja yang menemukan alamatnya. Kosongkan saat ngoding di lokal.
APP_PASSPHRASE=""
